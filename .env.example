# Copy to .env.local. Shell values override files; .env.local overrides .env.
EXTENSION_HOST_BASE_URL=http://127.0.0.1:8082
EXTENSION_ID=stephenson.gardener-orket
EXTENSION_TIMEOUT_SECONDS=300

# Supply the key configured on the Orket host. ORKET_API_KEY is a fallback.
EXTENSION_HOST_API_KEY=

# Optional HTTP adapter only: a separate token for its callers.
# Generate locally, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
EXTENSION_GATEWAY_TOKEN=

# gardener harness (`orket-extension gardener`). That command reads the process
# environment only (never this file) unless --config-dir is passed, because
# gardener runs it inside the target repository's clone.
# GARDENER_ORKET_PROVIDER=
# GARDENER_ORKET_MAX_TOKENS=768
# GARDENER_ORKET_REPORT_WORDS=250
# GARDENER_ORKET_MAX_TOTAL_BYTES=24000
# GARDENER_ORKET_MAX_FILE_BYTES=6000
# GARDENER_ORKET_MAX_FILES=400
# GARDENER_ORKET_DOCS=README.md,CLAUDE.md,AGENTS.md,CONTRIBUTING.md,SECURITY.md
